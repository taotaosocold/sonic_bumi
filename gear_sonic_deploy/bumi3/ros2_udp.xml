<?xml version="1.0" encoding="UTF-8"?>
<!-- 硬件桥以 root 运行、策略以普通用户运行时，两端统一使用 UDP，避免共享内存权限阻断消息。 -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>bumi3_udp</transport_id>
            <type>UDPv4</type>
        </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="bumi3_udp" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>bumi3_udp</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>
</profiles>
