<robot name="N3_origin">
    <link name="base_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://noetix_robots/n3/meshes/base_link.STL"/>
            </geometry>
            <material name="">
                <color rgba="0.498039215686275 0.498039215686275 0.498039215686275 1"/>
            </material>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0.08" />
            <geometry>
                <box size="0.16 0.12 0.10" />
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="-1.025132e-03 4.568900e-07 8.039310e-02"/>
            <mass value="6.277370e+00"/>
