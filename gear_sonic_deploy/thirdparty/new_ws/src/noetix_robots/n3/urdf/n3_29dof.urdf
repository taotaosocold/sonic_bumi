        </inertial>
    </link>
        <!-- ============================================== -->
    <!-- IMU frame: 与 base_link 同位置、同朝向            -->
    <!-- （IMU 机体系与 base_link 均为 REP-103）           -->
    <!-- ============================================== -->
    <link name="base_imu">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.01"/>
            <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
        </inertial>
    </link>

    <joint name="base_link_to_imu" type="fixed">
