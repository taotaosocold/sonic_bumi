<?xml version="1.0"?>
<package format="3">
  <name>noetix_policy</name>
  <version>0.1.0</version>
  <description>Generic ONNX policy runner for Noetix LowState/LowCmd.</description>
  <maintainer email="dev@noetix.local">Noetix</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>noetix_msgs</exec_depend>
  <exec_depend>noetix_robots</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
