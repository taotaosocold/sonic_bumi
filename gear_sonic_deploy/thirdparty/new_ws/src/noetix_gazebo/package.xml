<?xml version="1.0"?>
<package format="3">
  <name>noetix_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo Classic backend for Noetix LowCmd/LowState simulation.</description>
  <maintainer email="robotics@noetix.ai">Noetix Robotics</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>builtin_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>noetix_msgs</depend>
  <build_depend>gazebo_dev</build_depend>
  <depend>gazebo_ros</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>noetix_bridge</exec_depend>
  <exec_depend>noetix_robots</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
