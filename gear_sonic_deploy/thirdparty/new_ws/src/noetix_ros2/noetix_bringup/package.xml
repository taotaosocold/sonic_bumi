<?xml version="1.0"?>
<package format="3">
  <name>noetix_bringup</name>
  <version>0.2.0</version>
  <description>Real-hardware bringup for Noetix robots.</description>

  <maintainer email="robotics@noetix.ai">Noetix Robotics</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>joy</exec_depend>


  <exec_depend>noetix_bridge</exec_depend>
  <exec_depend>noetix_robots</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
